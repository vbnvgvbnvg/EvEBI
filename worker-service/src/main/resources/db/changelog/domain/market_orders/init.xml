<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. Pure Structural Table DDL -->
    <changeSet id="market_orders-001-create-table" author="serbentd">
        <comment>Create market_orders table structure</comment>
        <createTable tableName="market_orders">
            <column name="order_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_market_orders" nullable="false"/>
            </column>
            <column name="type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="region_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="system_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="NUMERIC(18, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="volume_remain" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="volume_total" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="min_volume" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="duration" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="is_buy_order" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="order_range" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>

            <!-- Order Lifecycle & Reconciliation State -->
            <column name="status" type="VARCHAR(16)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="snapshot_id" type="VARCHAR(64)"/>

            <!-- Market & Bitemporal Timestamps -->
            <column name="issued" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="polled_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <!-- 2. Performance Indexes -->
    <changeSet id="market_orders-002-create-indexes" author="serbentd">
        <comment>Create query performance indexes</comment>
        <createIndex tableName="market_orders" indexName="idx_market_orders_region_type">
            <column name="region_id"/>
            <column name="type_id"/>
        </createIndex>
        <createIndex tableName="market_orders" indexName="idx_market_orders_type">
            <column name="type_id"/>
        </createIndex>
        <createIndex tableName="market_orders" indexName="idx_market_orders_updated_at">
            <column name="updated_at"/>
        </createIndex>
        <createIndex tableName="market_orders" indexName="idx_market_orders_active">
            <column name="region_id"/>
            <column name="type_id"/>
            <column name="is_active"/>
        </createIndex>
        <createIndex tableName="market_orders" indexName="idx_market_orders_snapshot">
            <column name="snapshot_id"/>
        </createIndex>
    </changeSet>

    <!-- 3. Domain Documentation & Relational Remarks (Re-runnable on change) -->
    <changeSet id="market_orders-003-add-remarks" author="serbentd" runOnChange="true">
        <comment>Add table and column documentation with join references</comment>
        <setTableRemarks tableName="market_orders"
                         remarks="Raw active market orders snapshot ingested from EVE ESI"/>

        <setColumnRemarks tableName="market_orders" columnName="order_id"
                          remarks="Unique EVE order ID generated by CCP"/>
        <setColumnRemarks tableName="market_orders" columnName="type_id"
                          remarks="EVE item type identifier; joins to invTypes / universe item types"/>
        <setColumnRemarks tableName="market_orders" columnName="region_id"
                          remarks="EVE region identifier; joins to mapRegions (e.g. 10000002 for The Forge)"/>
        <setColumnRemarks tableName="market_orders" columnName="system_id"
                          remarks="EVE solar system identifier; joins to mapSolarSystems (e.g. 30000142 for Jita)"/>
        <setColumnRemarks tableName="market_orders" columnName="location_id"
                          remarks="Location where order is hosted; station ID (joins to staStations) or player Citadel / Upwell structure ID (ESI /universe/structures/{id})"/>
        <setColumnRemarks tableName="market_orders" columnName="price"
                          remarks="Order unit price in ISK"/>
        <setColumnRemarks tableName="market_orders" columnName="volume_remain"
                          remarks="Remaining quantity available for purchase or fulfillment"/>
        <setColumnRemarks tableName="market_orders" columnName="volume_total"
                          remarks="Original order volume when issued"/>
        <setColumnRemarks tableName="market_orders" columnName="min_volume"
                          remarks="Minimum volume that must be purchased in a single transaction"/>
        <setColumnRemarks tableName="market_orders" columnName="duration"
                          remarks="Order lifetime in days (typically 1 to 90)"/>
        <setColumnRemarks tableName="market_orders" columnName="is_buy_order"
                          remarks="Flag indicating order direction: true for buy orders (bids), false for sell orders (asks)"/>
        <setColumnRemarks tableName="market_orders" columnName="order_range"
                          remarks="Fulfillment visibility range: station, region, solarsystem, or jump distance (1-40)"/>
        <setColumnRemarks tableName="market_orders" columnName="status"
                          remarks="Lifecycle status: ACTIVE, FINISHED, CANCELLED, or EXPIRED"/>
        <setColumnRemarks tableName="market_orders" columnName="is_active"
                          remarks="Flag indicating whether order is currently active in the market"/>
        <setColumnRemarks tableName="market_orders" columnName="snapshot_id"
                          remarks="Identifier of the ingestion batch run that last confirmed this order active"/>
        <setColumnRemarks tableName="market_orders" columnName="issued"
                          remarks="UTC timestamp when the order was originally placed in EVE Online"/>
        <setColumnRemarks tableName="market_orders" columnName="polled_at"
                          remarks="UTC timestamp when this order snapshot was fetched from ESI (analytical time axis)"/>
        <setColumnRemarks tableName="market_orders" columnName="created_at"
                          remarks="UTC timestamp when this order was first inserted into our BI database"/>
        <setColumnRemarks tableName="market_orders" columnName="updated_at"
                          remarks="Internal pipeline UTC timestamp when the record was last synchronized in PostgreSQL"/>
        <setColumnRemarks tableName="market_orders" columnName="finished_at"
                          remarks="UTC timestamp when the order exited the active market"/>
    </changeSet>

</databaseChangeLog>
