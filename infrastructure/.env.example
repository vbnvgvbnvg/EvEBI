# ==========================================
# PostgreSQL Configuration
# ==========================================
POSTGRES_DB=eve_bi
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=prefer
POSTGRES_SUPERUSER=eve_user
POSTGRES_SUPERUSER_PASSWORD=eve_password

# Least-Privilege Database Roles
POSTGRES_LIQUIBASE_SCHEMA=liquibase
POSTGRES_LIQUIBASE_USER=liquibase_ddl
POSTGRES_LIQUIBASE_PASSWORD=eve_password
POSTGRES_WORKER_USER=worker_dml
POSTGRES_WORKER_PASSWORD=eve_password
POSTGRES_BATCH_USER=batch_dml
POSTGRES_BATCH_PASSWORD=eve_password
POSTGRES_POWERBI_USER=powerbi_reader
POSTGRES_POWERBI_PASSWORD=eve_password

# ==========================================
# RabbitMQ Configuration
# ==========================================
RABBITMQ_DEFAULT_USER=eve_user
RABBITMQ_DEFAULT_PASS=eve_password
RABBITMQ_VHOST=/eve_market
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_SSL_ENABLED=false
RABBITMQ_SSL_ALGORITHM=TLSv1.3

# Scoped Broker Roles (Application Client Credentials)
# Note: Local RabbitMQ container loads static role definitions from infrastructure/rabbitmq/definitions.json
# (default local password: eve_password). In production, provision broker users externally via IaC/Operator
# and inject the active role credentials into each service via RABBITMQ_USER and RABBITMQ_PASS.
RABBITMQ_POLLER_USER=poller_producer
RABBITMQ_POLLER_PASS=eve_password
RABBITMQ_WORKER_USER=worker_consumer
RABBITMQ_WORKER_PASS=eve_password
RABBITMQ_BATCH_MANAGER_USER=batch_manager_producer
RABBITMQ_BATCH_MANAGER_PASS=eve_password
RABBITMQ_BATCH_WORKER_USER=batch_worker_consumer
RABBITMQ_BATCH_WORKER_PASS=eve_password

# ==========================================
# Application Security (Local Development Only)
# Production deployments MUST provide strong, rotated secrets via secret stores.
# ==========================================
EVE_SECURITY_USER=eve_admin
EVE_SECURITY_PASSWORD=eve_password
EVE_SECURITY_API_KEY_HEADER=X-API-Key
EVE_SECURITY_API_KEYS=eve_local_api_key
EVE_SECURITY_ACTUATOR_API_KEYS=eve_local_actuator_key
EVE_SECURITY_OPERATOR_API_KEYS=eve_local_operator_key

# ==========================================
# Supply Chain Security Audit (Optional)
# ==========================================
# NVD API key increases OWASP Dependency-Check rate limits during -Psecurity-audit builds
# NVD_API_KEY=
