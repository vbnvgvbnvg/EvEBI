<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. Load Core Regions -->
    <changeSet id="baseline_seed-001-regions" author="serbentd">
        <comment>Seed core trade hub regions from CSV</comment>
        <loadData tableName="dim_region"
                  schemaName="analytics"
                  file="db/data/dim_regions.csv"
                  relativeToChangelogFile="false">
            <column name="region_id" type="NUMERIC"/>
            <column name="region_name" type="STRING"/>
            <column name="description" type="STRING"/>
            <column name="created_at" type="STRING"/>
            <column name="updated_at" type="STRING"/>
        </loadData>
    </changeSet>

    <!-- 2. Load Core NPC Trade Hub Stations -->
    <changeSet id="baseline_seed-002-stations" author="serbentd">
        <comment>Seed primary trade hub NPC stations from CSV</comment>
        <loadData tableName="dim_station"
                  schemaName="analytics"
                  file="db/data/dim_stations.csv"
                  relativeToChangelogFile="false">
            <column name="station_id" type="NUMERIC"/>
            <column name="station_name" type="STRING"/>
            <column name="solar_system_id" type="NUMERIC"/>
            <column name="solar_system_name" type="STRING"/>
            <column name="region_id" type="NUMERIC"/>
            <column name="security_status" type="NUMERIC"/>
            <column name="security_class" type="STRING"/>
            <column name="is_structure" type="BOOLEAN"/>
            <column name="created_at" type="STRING"/>
            <column name="updated_at" type="STRING"/>
        </loadData>
    </changeSet>

    <!-- 3. Load Core Traded Items -->
    <changeSet id="baseline_seed-003-items" author="serbentd">
        <comment>Seed core minerals, PLEX, and ship hulls from CSV</comment>
        <loadData tableName="dim_item"
                  schemaName="analytics"
                  file="db/data/dim_items.csv"
                  relativeToChangelogFile="false">
            <column name="type_id" type="NUMERIC"/>
            <column name="type_name" type="STRING"/>
            <column name="group_id" type="NUMERIC"/>
            <column name="group_name" type="STRING"/>
            <column name="category_id" type="NUMERIC"/>
            <column name="category_name" type="STRING"/>
            <column name="market_group_id" type="NUMERIC"/>
            <column name="volume" type="NUMERIC"/>
            <column name="packaged_volume" type="NUMERIC"/>
            <column name="portion_size" type="NUMERIC"/>
            <column name="is_published" type="BOOLEAN"/>
            <column name="created_at" type="STRING"/>
            <column name="updated_at" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
